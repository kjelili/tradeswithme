# Personal dashboard access. If omitted, scan APIs are open to anyone who can reach the URL.
APP_ACCESS_CODE=choose-a-long-private-code

# Vercel automatically sends this as Authorization: Bearer <CRON_SECRET> to cron routes.
CRON_SECRET=choose-another-long-random-secret

# Stocks, ETFs and crypto pairs scanned by the daily Vercel cron. Max 30.
PERSONAL_WATCHLIST=SPY,QQQ,IWM,DIA,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,AVGO,NFLX,PLTR,JPM,BAC,XOM,GLD,TLT,BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,ADA-USD,LINK-USD,AVAX-USD,DOT-USD,LTC-USD

# Server-side persistence and V4.1 forward-validation ledger.
# Run supabase/schema.sql first. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Backward-compatible legacy variable name (use one, not both):
SUPABASE_SERVICE_ROLE_KEY=

# Optional equity earnings calendar. If blank, V4.1 marks equity earnings risk UNVERIFIED
# and still applies abnormal price/volume event checks.
ALPHAVANTAGE_API_KEY=

# Scheduled scan paper-allocation ceiling. Server clamps this to £50 maximum.
OVERNIGHT_PAPER_BUDGET_GBP=50

# V4.1 equity data needs no additional key: it uses a redundant Yahoo-chart -> Stooq chain.
# Upstream public endpoints can still throttle/change; the app fails closed if both are unavailable.

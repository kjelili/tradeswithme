APP_ACCESS_CODE=replace-with-a-private-code
CRON_SECRET=replace-with-a-different-long-random-secret
PERSONAL_WATCHLIST=SPY,QQQ,IWM,DIA,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,AVGO,NFLX,PLTR,JPM,BAC,XOM,GLD,TLT,BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,ADA-USD,LINK-USD,AVAX-USD,DOT-USD,LTC-USD,BNB-USD,BCH-USD,TRX-USD,XLM-USD,HBAR-USD,SUI-USD,TON-USD,NEAR-USD,AAVE-USD,UNI-USD,SHIB-USD,PEPE-USD,ICP-USD,ATOM-USD,ALGO-USD,FIL-USD,ETC-USD,XTZ-USD
OVERNIGHT_PAPER_BUDGET_GBP=50
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
ALPHAVANTAGE_API_KEY=

# Optional direct on-chain large-transfer context. Without it, V5.1 uses a clearly labelled market-flow proxy.
WHALE_ALERT_API_KEY=
WHALE_ALERT_MIN_USD=1000000

# V5.3 commercial layer (all optional; the site works without them)
# Stripe Payment Links (Dashboard → Payment Links). Leave blank to show "reserve a seat" forms instead.
STRIPE_FOUNDER_LINK=
STRIPE_SETUP_LINK=
FOUNDER_PRICE=£19
SETUP_PRICE=£149
FOUNDER_SEATS=100
CONTACT_EMAIL=hello@tradeswithme.com

# V5.4 broker execution. Default is OFF. Real money also requires VALIDATED forward evidence.
EXECUTION_MODE=off            # off | paper | live
LIVE_HARD_CAP_GBP=50          # total £ the bot may ever have deployed (code ceiling £1,000)
LOSS_BREAKER_PCT=40           # halt live entries if 30-day realised loss ≥ this % of the cap
TRADING_KILL_SWITCH=          # set to "on" to block all new entries without a redeploy of code
# Alpaca (US equities). Paper keys from the Paper dashboard; live keys only when ready.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=
# Kraken (crypto). Key permissions: Query Funds, Query/Create/Cancel Orders. NEVER Withdraw.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Optional email alerts (resend.com)
RESEND_API_KEY=
ALERT_EMAIL=
ALERT_FROM=

# V5.7 strategy audit offer
STRIPE_AUDIT_LINK=
AUDIT_PRICE=£99

# V5.8 Trading 212 ISA rebalance assistant (Settings → API in the Trading 212 app; Stocks ISA supported, API is beta)
# Key scopes: account, portfolio, metadata, orders:execute. Start on demo (practice account keys).
T212_API_KEY=
T212_API_SECRET=
T212_ENV=demo                 # demo | live
# US proxy → your Trading 212 ticker. Verify each in the instrument list before going live. Example:
# T212_TICKER_MAP={"SPY":"VUAGl_EQ","QQQ":"EQQQl_EQ","EEM":"EMIMl_EQ","GLD":"SGLNl_EQ","TLT":"IDTLl_EQ","VT":"VWRPl_EQ"}
T212_TICKER_MAP=
T212_QTY_DECIMALS=2
REBALANCE_STRATEGY=ensemble   # any strategy id from the desk table
REBALANCE_AUTO=off            # on = the weekday 10:40 UTC job executes the month's plan without approval
REBALANCE_BUDGET=             # optional: manage at most this much (account currency)
REBALANCE_BAND_PCT=3          # skip drifts smaller than this % of the managed value
REBALANCE_MIN_ORDER=10
REBALANCE_MAX_ORDER=1000      # per order cap (code ceiling 25,000)
